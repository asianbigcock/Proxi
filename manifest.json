{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["proxy", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Proxi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/system-16.png",
      "32": "icons/system-32.png",
      "48": "icons/system-48.png",
      "128": "icons/system-128.png"
    }
  },
  "icons": {
    "16": "icons/system-16.png",
    "32": "icons/system-32.png",
    "48": "icons/system-48.png",
    "128": "icons/system-128.png"
  },
  "commands": {
    "set_direct": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "切换为直接连接"
    },
    "set_system": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "切换为系统代理"
    },
    "set_global": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "切换为全局代理"
    }
  }
}